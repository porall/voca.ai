# Voca.ai Environment Variables
# Copy this file to .env and fill in your values

# App
APP_NAME=Voca.ai
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/vocadb

# Redis
REDISTOGO_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-in-production-min-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=259200  # 30 days

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# S3/OSS Storage
S3_BUCKET=voca-ai-files
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI APIs
SUNO_API_URL=https://api.suno.ai
REECHO_API_URL=https://api.reecho.ai
REECHO_API_KEY=