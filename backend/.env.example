# Database
DATABASE_URL=sqlite:///./vocadb.sqlite

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:5173,https://your-domain.ngrok-free.dev

# S3/OSS
S3_BUCKET=voca-ai-files
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# AI APIs
SUNO_API_URL=https://open.suno.cn/api/v1
SUNO_API_KEY=your_suno_api_key
REECHO_API_URL=https://api.reecho.ai
REECHO_API_KEY=your_reecho_api_key